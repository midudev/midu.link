{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "midu-link",
	"account_id": "599228840df452ef6b4df93a2b67c0ee",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-24",
	// The Cloudflare Vite plugin points this at Astro's dist/client on build.
	"assets": { "binding": "ASSETS" },
	"routes": [{ "pattern": "midu.link", "custom_domain": true }],
	// Click analytics. No database_id: `wrangler deploy` creates the database
	// (or links the existing one by name) and writes the ID back here.
	"d1_databases": [{ "binding": "DB", "database_name": "midu-link" }],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
