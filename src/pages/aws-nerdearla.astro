		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Aprende a crear agentes de IA desde cero. Midu en el stand de AWS, Nerdearla 2026. Viernes 25 de septiembre, 12:15 Buenos Aires." />
		<meta property="event:start_time" content={EVENT.startUTC} />
		<meta property="event:end_time" content={EVENT.endUTC} />

		<!-- Twitter Card -->
