---
/**
 * Landing especial: sesión de Midu en el stand de AWS en Nerdearla 2026.
 * Ruta estática → gana sobre el redirect dinámico de `[slug].ts`.
 * Todo (HTML + CSS + JS) vive en este archivo; sin frameworks ni backend.
 */

const REGISTER_URL = 'https://bit.ly/46WF8l6';

const EVENT = {
	title: 'Taller midudev en Nerdearla - AWS Strands SDK',
	startUTC: '2026-09-25T15:15:00Z',
	endUTC: '2026-09-25T15:45:00Z',
	location: 'Silent Theatre del stand de AWS, Nerdearla, Ciudad Cultural Konex, Sarmiento 3131, Buenos Aires, Argentina',
	description: [
		'Sesión de 30 minutos de Midu (@midudev) junto a AWS: un proyecto real construido con Strands, el framework open source de AWS para crear agentes de IA. Cómo lo hice paso a paso, demo en directo y preguntas.',
		'',
		'Lugar: Silent Theatre del stand de AWS, dentro de Nerdearla. Ciudad Cultural Konex, Sarmiento 3131, Buenos Aires, Argentina. Se escucha con auriculares inalámbricos que reparten en el stand.',
		'',
		'Aforo limitado. Acceso por orden de llegada: llega con antelación. No hay registro para la sesión, solo necesitas estar registrado en Nerdearla (gratis).',
		`Regístrate en Nerdearla: ${REGISTER_URL}`,
	].join('\n'),
};

const googleCalendarUrl = (() => {
	const params = new URLSearchParams({
		action: 'TEMPLATE',
		text: EVENT.title,
		dates: '20260925T151500Z/20260925T154500Z',
		details: EVENT.description,
		location: EVENT.location,
		ctz: 'America/Argentina/Buenos_Aires',
	});
	return `https://calendar.google.com/calendar/render?${params.toString()}`;
})();

const outlookParams = new URLSearchParams({
	path: '/calendar/action/compose',
	rru: 'addevent',
	subject: EVENT.title,
	startdt: EVENT.startUTC,
	enddt: EVENT.endUTC,
	body: EVENT.description,
	location: EVENT.location,
});
const outlookLiveUrl = `https://outlook.live.com/calendar/0/deeplink/compose?${outlookParams.toString()}`;
const outlookOfficeUrl = `https://outlook.office.com/calendar/0/deeplink/compose?${outlookParams.toString()}`;

const calendarOptions = [
	{ label: 'Google Calendar', href: googleCalendarUrl },
	{ label: 'Apple Calendar (.ics)', ics: true },
	{ label: 'Outlook.com', href: outlookLiveUrl },
	{ label: 'Outlook 365', href: outlookOfficeUrl },
	{ label: 'Otro calendario (.ics)', ics: true },
];

const pageTitle = 'Aprende a crear agentes de IA desde cero · Midu en Nerdearla 2026';
const pageDescription =
	'Viernes 25 de septiembre de 2026, 12:15 (Buenos Aires). Sesión de 30 min de Midu en el Silent Theatre del stand de AWS en Nerdearla: un proyecto real con Strands, demo en directo y preguntas. Aforo limitado, entrada gratis con registro en Nerdearla.';
const canonical = new URL('/aws-nerdearla', Astro.site ?? 'https://midu.link').href;
const ogImage = new URL('/og/aws-nerdearla.png', Astro.site ?? 'https://midu.link').href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: EVENT.title,
	description: pageDescription,
	startDate: '2026-09-25T12:15:00-03:00',
	endDate: '2026-09-25T12:45:00-03:00',
	eventStatus: 'https://schema.org/EventScheduled',
	eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
	inLanguage: 'es',
	isAccessibleForFree: true,
	url: canonical,
	image: ogImage,
	location: {
		'@type': 'Place',
		name: 'Silent Theatre del stand de AWS · Nerdearla · Ciudad Cultural Konex',
		address: {
			'@type': 'PostalAddress',
			streetAddress: 'Sarmiento 3131',
			addressLocality: 'Buenos Aires',
			addressCountry: 'AR',
		},
	},
	performer: { '@type': 'Person', name: 'Miguel Ángel Durán (midudev)', url: 'https://midu.dev' },
	organizer: { '@type': 'Organization', name: 'AWS', url: 'https://aws.amazon.com' },
	superEvent: {
		'@type': 'Event',
		name: 'Nerdearla Argentina 2026',
		startDate: '2026-09-22',
		endDate: '2026-09-26',
		url: REGISTER_URL,
	},
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'ARS', url: REGISTER_URL, availability: 'https://schema.org/LimitedAvailability' },
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/aws.png" />
		<link
			rel="preload"
			href="/fonts/geist-pixel-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
			fetchpriority="high"
		/>
		<link
			rel="preload"
			href="/fonts/geist-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
			fetchpriority="high"
		/>
		<style is:inline>
			@font-face {
				font-family: 'Geist Pixel';
				src: url('/fonts/geist-pixel-latin.woff2') format('woff2');
				font-weight: 400;
				font-style: normal;
				font-display: optional;
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Geist';
				src: url('/fonts/geist-latin.woff2') format('woff2');
				font-weight: 400 600;
				font-style: normal;
				font-display: optional;
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
		</style>

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content="midudev" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
