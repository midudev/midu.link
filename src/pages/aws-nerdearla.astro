				<ul class="list">
					<li>
						<strong>Dirección.</strong> Ciudad Cultural Konex, Sarmiento 3131, Buenos Aires, Argentina.
						<a href="https://maps.google.com/?q=Ciudad+Cultural+Konex,+Sarmiento+3131,+Buenos+Aires" target="_blank" rel="noopener noreferrer">Ver en el mapa</a>
					</li>
					<li><strong>Stand de AWS.</strong> La sesión es en su Silent Theatre, dentro del recinto de Nerdearla.</li>
					<li><strong>Silent theatre.</strong> Se escucha por auriculares inalámbricos que reparten en el stand.</li>
					<li><strong>Aforo limitado.</strong> Acceso por orden de llegada. Llega con antelación.</li>
					<li><strong>Sin registro para la sesión.</strong> Solo necesitas estar registrado en Nerdearla, que es gratis.</li>
				</ul>
				<p class="note">
					Nerdearla Argentina 2026, 13ª edición · 22–26 de septiembre. Los días presenciales en Konex son 24, 25 y 26.
				</p>
			</section>

			<!-- 4. Sobre Midu -->
			<section aria-labelledby="midu-title">
				<h2 id="midu-title" class="section-title">Sobre Midu</h2>
				<p>
					Miguel Ángel Durán, creador de contenido de desarrollo web en español.
					<a href="https://youtube.com/@midudev" target="_blank" rel="noopener noreferrer">YouTube</a>,
					<a href="https://twitch.tv/midudev" target="_blank" rel="noopener noreferrer">Twitch</a> y
					<a href="https://x.com/midudev" target="_blank" rel="noopener noreferrer">X</a>: @midudev.
				</p>
			</section>

			<!-- 5. Cierre -->
			<section class="closing" aria-labelledby="cierre-title">
				<h2 id="cierre-title" class="section-title">Nos vemos en el stand de AWS</h2>
				<p class="lead">Viernes 25 de septiembre, 12:15 (Buenos Aires). Guárdalo para que no se te olvide.</p>
				<div class="cta">
					<details class="menu js-menu">
						<summary class="btn btn--primary" aria-haspopup="menu" aria-controls="menu-cierre">Me apunto</summary>
						<ul class="menu__list" id="menu-cierre" role="menu" aria-label="Añadir a tu calendario">
							{calendarOptions.map((o) => (
								<li role="none">
									{o.ics ? (
										<button type="button" role="menuitem" class="menu__item js-download-ics">{o.label}</button>
									) : (
										<a role="menuitem" class="menu__item" href={o.href} target="_blank" rel="noopener noreferrer">{o.label}</a>
									)}
								</li>
							))}
						</ul>
					</details>
					<a class="btn btn--ghost" href={REGISTER_URL} target="_blank" rel="noopener noreferrer">
						Regístrate en Nerdearla (gratis)
					</a>
				</div>
				<p class="cta__hint">Elige tu calendario y guarda la sesión para que no se te olvide.</p>
			</section>
		</main>

		<footer class="foot">
			<p>Sesión organizada junto a AWS · <a href="/">midu.link</a></p>
		</footer>

		<script define:vars={{ EVENT, REGISTER_URL }}>
			// ---------- .ics (generado en cliente, fechas en UTC) ----------
			const icsEscape = (s) => String(s).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');

			// RFC 5545: líneas de máx. 75 octetos, continuación con espacio.
			const fold = (line) => {
				const bytes = new TextEncoder().encode(line);
				if (bytes.length <= 75) return line;
				const out = [];
				let chunk = '';
				let size = 0;
				for (const ch of line) {
					const len = new TextEncoder().encode(ch).length;
					if (size + len > (out.length ? 74 : 75)) {
						out.push(chunk);
						chunk = '';
						size = 0;
					}
					chunk += ch;
					size += len;
				}
				if (chunk) out.push(chunk);
				return out.join('\r\n ');
			};

			const toIcsDate = (iso) => iso.replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
			const uid = 'aws-nerdearla-2026-strands@midu.link';

			const buildIcs = () => {
				const lines = [
					'BEGIN:VCALENDAR',
					'VERSION:2.0',
					'PRODID:-//midu.link//aws-nerdearla//ES',
					'CALSCALE:GREGORIAN',
					'METHOD:PUBLISH',
					'BEGIN:VEVENT',
					`UID:${uid}`,
					`DTSTAMP:${toIcsDate(new Date().toISOString())}`,
					`DTSTART:${toIcsDate(EVENT.startUTC)}`,
					`DTEND:${toIcsDate(EVENT.endUTC)}`,
					`SUMMARY:${icsEscape(EVENT.title)}`,
					`DESCRIPTION:${icsEscape(EVENT.description)}`,
					`LOCATION:${icsEscape(EVENT.location)}`,
					`URL:${window.location.origin}/aws-nerdearla`,
					'STATUS:CONFIRMED',
					'TRANSP:OPAQUE',
					'BEGIN:VALARM',
					'ACTION:DISPLAY',
					`DESCRIPTION:${icsEscape('Empieza en 30 min: ' + EVENT.title)}`,
					'TRIGGER:-PT30M',
					'END:VALARM',
					'END:VEVENT',
					'END:VCALENDAR',
				];
				return lines.map(fold).join('\r\n') + '\r\n';
			};

			const downloadIcs = () => {
				const blob = new Blob([buildIcs()], { type: 'text/calendar;charset=utf-8' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'midu-strands-nerdearla-2026.ics';
				a.rel = 'noopener';
				document.body.appendChild(a);
				a.click();
				a.remove();
				setTimeout(() => URL.revokeObjectURL(url), 10_000);
			};

			const menus = Array.from(document.querySelectorAll('.js-menu'));
			const closeMenus = (except) => {
				for (const m of menus) if (m !== except) m.open = false;
			};

			for (const menu of menus) {
				menu.addEventListener('toggle', () => {
					if (menu.open) closeMenus(menu);
				});
			}

			document.addEventListener('click', (e) => {
				if (!menus.some((m) => m.contains(e.target))) closeMenus();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return;
				const open = menus.find((m) => m.open);
				if (open) {
					open.open = false;
					open.querySelector('summary')?.focus();
				}
			});

			for (const btn of document.querySelectorAll('.js-download-ics')) {
				btn.addEventListener('click', () => {
					downloadIcs();
					closeMenus();
				});
			}

			// ---------- Cuenta atrás (instante absoluto; equivale a 12:15 en Buenos Aires) ----------
			const start = Date.parse(EVENT.startUTC);
			const end = Date.parse(EVENT.endUTC);
			const grid = document.querySelector('.js-countdown');
			const status = document.querySelector('.js-countdown-status');
			const cells = Object.fromEntries(
				Array.from(grid.querySelectorAll('[data-unit]')).map((el) => [el.dataset.unit, el]),
			);
			const pad = (n) => String(n).padStart(2, '0');

			const tick = () => {
				const now = Date.now();
				if (now >= end) {
					grid.hidden = true;
					status.textContent = 'La sesión ya terminó. ¡Gracias por venir!';
					return false;
				}
				if (now >= start) {
					grid.hidden = true;
					status.textContent = 'La sesión está en marcha ahora mismo en el Silent Theatre del stand de AWS.';
					return true;
				}
				let diff = Math.floor((start - now) / 1000);
				const days = Math.floor(diff / 86400);
				diff -= days * 86400;
				const hours = Math.floor(diff / 3600);
				diff -= hours * 3600;
				const minutes = Math.floor(diff / 60);
				const seconds = diff - minutes * 60;
				cells.days.textContent = String(days);
				cells.hours.textContent = pad(hours);
				cells.minutes.textContent = pad(minutes);
				cells.seconds.textContent = pad(seconds);
				return true;
			};

			if (tick()) {
				const id = setInterval(() => {
					if (!tick()) clearInterval(id);
				}, 1000);
			}
		</script>
	</body>
</html>

<style is:global>
	/* Una sola tinta de acento. Oscuro por defecto; claro con prefers-color-scheme. */
	:root {
		color-scheme: dark;
		--bg: #0a0a0a;
		--text: #ededed;
		--muted: #9a9a9a;
		--border: #262626;
		--accent: #ff9900;
		--accent-ink: #0a0a0a;
		--focus: #ffffff;
		--sans: 'Geist', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--pixel: 'Geist Pixel', ui-monospace, SFMono-Regular, Menlo, monospace;
		--maxw: 42rem;
	}

	@media (prefers-color-scheme: light) {
		:root {
			color-scheme: light;
			--bg: #fafafa;
			--text: #111111;
			--muted: #5c5c5c;
			--border: #dcdcdc;
			--accent: #b45309;
			--accent-ink: #ffffff;
			--focus: #111111;
		}
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-family: var(--sans);
		background: var(--bg);
		color: var(--text);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
		font-size: 100%;
		line-height: 1.55;
		font-synthesis: none;
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	::selection {
		background: var(--accent);
		color: var(--accent-ink);
	}

	a {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--muted);
	}

	a:hover {
		text-decoration-color: var(--accent);
	}

	:is(a, button):focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.skip {
		position: absolute;
