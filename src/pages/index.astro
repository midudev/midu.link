---
import Layout from '../layouts/Layout.astro';
import links from '../data/links.json';

const sortedLinks = [...links].sort((a, b) => a.slug.localeCompare(b.slug));

const prettyUrl = (url: string) => {
	try {
		const u = new URL(url);
		return u.hostname.replace(/^www\./, '') + (u.pathname !== '/' ? u.pathname : '');
	} catch {
		return url;
	}
};
---

<Layout>
	<main>
		<header>
			<h1>midu.link</h1>
			<p class="subtitle">
				Acortador de URLs de <a href="https://midu.dev" target="_blank" rel="noopener noreferrer">midudev</a>
			</p>
			<p class="count">
				<span id="count">{links.length}</span> enlaces disponibles
			</p>
		</header>

		<div class="search-wrapper">
			<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
				<path d="m20 20-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
			<input
				id="search"
				type="search"
				aria-label="Buscar enlace"
				placeholder="Buscar por nombre o destino..."
				autocomplete="off"
				spellcheck="false"
				autofocus
			/>
			<kbd class="kbd">/</kbd>
		</div>

		<section class="links" id="links-list">
			{sortedLinks.map(({ slug, url }) => {
				const target = prettyUrl(url);
				return (
					<div class="link-card" data-slug={slug} data-target={target}>
						<a
							href={`/${slug}`}
							class="link-main"
							target="_blank"
							rel="nofollow noopener noreferrer"
						>
							<span class="link-slug">
								<span class="domain">midu.link/</span><span class="slug">{slug}</span>
							</span>
							<span class="link-target">{target}</span>
						</a>

						<div class="analytics" aria-label={`Estadísticas de midu.link/${slug}`} data-analytics={slug}>
							<svg class="spark" viewBox="0 0 56 22" width="56" height="22" aria-hidden="true" preserveAspectRatio="none">
								{/* 7 placeholder bars — filled by client script */}
								{[0, 1, 2, 3, 4, 5, 6].map((i) => (
									<rect
										class="spark-bar"
										data-i={i}
										x={i * 8}
										y={18}
										width="5"
										height="2"
										rx="1"
									/>
								))}
							</svg>
							<div class="stats">
								<span class="stat" title="Clicks hoy (UTC)">
									<span class="stat-value" data-today>—</span>
									<span class="stat-label">hoy</span>
								</span>
								<span class="stat" title="Clicks últimos 7 días">
									<span class="stat-value" data-week>—</span>
									<span class="stat-label">7d</span>
								</span>
							</div>
						</div>

						<button class="copy" type="button" data-slug={slug} aria-label={`Copiar midu.link/${slug}`}>
							<svg class="icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<rect x="9" y="9" width="11" height="11" rx="2.5" stroke="currentColor" stroke-width="2" />
								<path d="M5 15V5.5A1.5 1.5 0 0 1 6.5 4H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
							</svg>
							<svg class="icon-check" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="m5 12 4.5 4.5L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
					</div>
				);
			})}
		</section>

		<p id="no-results" class="no-results" hidden>
			No se encontraron enlaces para <span id="query-echo"></span>
		</p>

		<footer>
			<a href="https://github.com/midudev/midu.link" target="_blank" rel="noopener noreferrer">
				Código abierto en GitHub
			</a>
		</footer>
	</main>
</Layout>

<script>
	const search = document.getElementById('search') as HTMLInputElement;
	const list = document.getElementById('links-list')!;
	const count = document.getElementById('count')!;
	const noResults = document.getElementById('no-results')!;
	const queryEcho = document.getElementById('query-echo')!;
	const cards = Array.from(list.querySelectorAll<HTMLElement>('.link-card'));
	const total = cards.length;

	const runFilter = () => {
		const query = search.value.trim().toLowerCase();
		let visible = 0;

		for (const card of cards) {
			const slug = card.dataset.slug!.toLowerCase();
			const target = card.dataset.target!.toLowerCase();
			const matches = !query || slug.includes(query) || target.includes(query);
			card.hidden = !matches;
			if (matches) visible++;
		}

		count.textContent = String(query ? visible : total);
		queryEcho.textContent = query ? `"${query}"` : '';
		noResults.hidden = visible > 0;
	};

	search.addEventListener('input', runFilter);

	// Prefill from ?q= (enables Google's sitelinks search box → this page)
	const initialQuery = new URLSearchParams(location.search).get('q');
	if (initialQuery) {
		search.value = initialQuery;
		runFilter();
	}

	// Keyboard: "/" focuses search, Escape clears it
	document.addEventListener('keydown', (e) => {
		if (e.key === '/' && document.activeElement !== search) {
			e.preventDefault();
			search.focus();
			search.select();
		}
		if (e.key === 'Escape' && document.activeElement === search) {
			search.value = '';
			search.dispatchEvent(new Event('input'));
			search.blur();
		}
	});

	// Copy midu.link/<slug> to clipboard
	let resetTimer: ReturnType<typeof setTimeout>;
	list.addEventListener('click', async (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy');
		if (!btn) return;
		e.preventDefault();

		const shortUrl = `${location.origin}/${btn.dataset.slug}`;
		try {
			await navigator.clipboard.writeText(shortUrl);
		} catch {
			return;
		}

		document.querySelectorAll('.copy.copied').forEach((el) => el.classList.remove('copied'));
		clearTimeout(resetTimer);
		btn.classList.add('copied');
		resetTimer = setTimeout(() => btn.classList.remove('copied'), 1400);
	});

	// ---------- Analytics sparklines ----------
	type DayCount = { day: string; count: number };
	type SlugStats = { days: DayCount[]; today: number; week: number };

	const SPARK_H = 22;
	const BAR_MIN = 2;
	const BAR_MAX = 20;

	function formatCount(n: number): string {
		if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
		if (n >= 10_000) return `${Math.round(n / 1000)}k`;
		if (n >= 1000) return `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k`;
		return String(n);
	}

	function paintSpark(root: HTMLElement, stats: SlugStats) {
		const counts = stats.days.map((d) => d.count);
		const max = Math.max(...counts, 1);

		root.querySelectorAll<SVGRectElement>('.spark-bar').forEach((bar) => {
			const i = Number(bar.dataset.i);
			const value = counts[i] ?? 0;
			const h = value === 0 ? BAR_MIN : Math.max(BAR_MIN, Math.round((value / max) * BAR_MAX));
			bar.setAttribute('y', String(SPARK_H - h));
			bar.setAttribute('height', String(h));
			bar.classList.toggle('is-today', i === counts.length - 1);
			bar.classList.toggle('has-clicks', value > 0);
		});

		const todayEl = root.querySelector<HTMLElement>('[data-today]');
		const weekEl = root.querySelector<HTMLElement>('[data-week]');
		if (todayEl) todayEl.textContent = formatCount(stats.today);
		if (weekEl) weekEl.textContent = formatCount(stats.week);

		root.classList.add('is-loaded');
		root.title = `Hoy: ${stats.today} · 7 días: ${stats.week}`;
	}

	async function loadStats() {
		try {
			const res = await fetch('/api/stats');
			if (!res.ok) return;
			const data = (await res.json()) as Record<string, SlugStats>;

			for (const card of cards) {
				const slug = card.dataset.slug!;
				const panel = card.querySelector<HTMLElement>('[data-analytics]');
				if (!panel) continue;
				const stats = data[slug] ?? {
					days: Array.from({ length: 7 }, (_, i) => ({ day: String(i), count: 0 })),
					today: 0,
					week: 0,
				};
				paintSpark(panel, stats);
			}
		} catch {
			// Stats are progressive enhancement — ignore failures.
		}
	}

	loadStats();
</script>

<style>
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 4rem 1.5rem 3rem;
	}

	/* ---------- Header ---------- */
	header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	h1 {
		font-family: var(--pixel);
		font-size: clamp(2.75rem, 11vw, 4.25rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.01em;
		color: var(--text);
		margin-bottom: 1.1rem;
	}

	.subtitle {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.subtitle a {
		color: var(--text);
		text-decoration: none;
		border-bottom: 1px solid var(--border-hover);
		transition: border-color 0.15s, color 0.15s;
	}

	.subtitle a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.count {
		margin-top: 0.9rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4ch;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--muted);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
	}

	.count #count {
		color: var(--text);
		font-weight: 600;
	}

	/* ---------- Search ---------- */
	.search-wrapper {
		position: sticky;
		top: 0.75rem;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0 0.9rem;
		margin-bottom: 1.5rem;
		border-radius: var(--radius);
		background: rgba(16, 16, 16, 0.85);
		border: 1px solid var(--border);
		backdrop-filter: blur(12px);
		transition: border-color 0.15s, box-shadow 0.15s;
	}

	.search-wrapper:focus-within {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	.search-icon {
		flex-shrink: 0;
		color: var(--dim);
		transition: color 0.15s;
	}

	.search-wrapper:focus-within .search-icon {
		color: var(--accent);
	}

	#search {
		flex: 1;
		width: 100%;
		padding: 0.85rem 0;
		background: transparent;
		border: none;
		color: var(--text);
		font-family: var(--mono);
		font-size: 0.95rem;
		outline: none;
	}

	#search::placeholder {
		color: var(--dim);
	}

	#search::-webkit-search-cancel-button {
		-webkit-appearance: none;
		appearance: none;
	}

	.kbd {
		flex-shrink: 0;
		min-width: 1.6rem;
		height: 1.6rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--border-hover);
		border-radius: 6px;
		background: var(--bg);
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.8rem;
	}

	.search-wrapper:focus-within .kbd {
		opacity: 0;
	}

	/* ---------- Links ---------- */
	.links {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.link-card {
		display: flex;
		align-items: stretch;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--border);
		transition: background 0.15s, border-color 0.15s, transform 0.15s;
		content-visibility: auto;
		contain-intrinsic-size: auto 64px;
	}

	.link-card[hidden] {
		display: none;
	}

	.link-card:hover {
		background: var(--surface-hover);
		border-color: var(--border-hover);
	}

	.link-main {
		flex: 1;
		min-width: 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 0.5rem 0.9rem 1.15rem;
		text-decoration: none;
		color: inherit;
	}

	.link-slug {
		flex-shrink: 0;
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.domain {
		color: var(--dim);
	}

	.slug {
		color: var(--text);
		font-weight: 500;
	}

	.link-card:hover .slug {
		color: var(--accent);
	}

	.link-target {
		min-width: 0;
		color: var(--muted);
		font-size: 0.78rem;
		text-align: right;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* ---------- Analytics ---------- */
	.analytics {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0 0.55rem 0 0.35rem;
		border-left: 1px solid var(--border);
		opacity: 0.45;
		transition: opacity 0.2s;
		font-variant-numeric: tabular-nums;
	}

	.analytics.is-loaded {
		opacity: 1;
	}

	.spark {
		display: block;
		overflow: visible;
	}

	.spark-bar {
		fill: var(--dim);
		transition: y 0.25s ease, height 0.25s ease, fill 0.15s;
	}

	.spark-bar.has-clicks {
		fill: color-mix(in srgb, var(--accent) 55%, var(--dim));
	}

	.spark-bar.is-today {
		fill: var(--accent);
	}

	.stats {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 2.6rem;
	}

	.stat {
		display: flex;
		align-items: baseline;
		justify-content: flex-end;
		gap: 0.3ch;
		line-height: 1.15;
	}

	.stat-value {
		color: var(--text);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.stat-label {
		color: var(--dim);
		font-size: 0.58rem;
		text-transform: lowercase;
	}

	/* ---------- Copy button ---------- */
	.copy {
		flex-shrink: 0;
		width: 3rem;
		display: grid;
		place-items: center;
		border: none;
		border-left: 1px solid var(--border);
		border-radius: 0 var(--radius) var(--radius) 0;
		background: transparent;
		color: var(--dim);
		cursor: pointer;
		transition: color 0.15s, background 0.15s;
	}

	.copy:hover {
		color: var(--text);
		background: var(--accent-soft);
	}

	.copy svg {
		grid-area: 1 / 1;
		transition: opacity 0.15s, transform 0.15s;
	}

	.copy .icon-check {
		opacity: 0;
		transform: scale(0.6);
		color: var(--accent);
	}

	.copy.copied {
		color: var(--accent);
	}

	.copy.copied .icon-copy {
		opacity: 0;
		transform: scale(0.6);
	}

	.copy.copied .icon-check {
		opacity: 1;
		transform: scale(1);
	}

	/* ---------- Empty state + footer ---------- */
	.no-results {
		text-align: center;
		color: var(--muted);
		padding: 3rem 0;
		font-size: 0.9rem;
	}

	.no-results span {
		color: var(--text);
	}

	footer {
		margin-top: 3rem;
		text-align: center;
	}

	footer a {
		color: var(--dim);
		text-decoration: none;
		font-size: 0.78rem;
		transition: color 0.15s;
	}

	footer a:hover {
		color: var(--muted);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 640px) {
		main {
			padding: 2.5rem 1rem 2rem;
		}

		.link-main {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
			padding: 0.85rem 0.5rem 0.85rem 1rem;
		}

		.link-target {
			text-align: left;
			max-width: 100%;
		}

		.analytics {
			flex-direction: column;
			justify-content: center;
			gap: 0.25rem;
			padding: 0 0.4rem;
		}

		.stats {
			flex-direction: row;
			gap: 0.45rem;
			min-width: 0;
		}

		.kbd {
			display: none;
		}
	}

	@media (max-width: 400px) {
		.spark {
			display: none;
		}
	}
</style>
