---
/**
 * Landing minimalista a pantalla dividida:
 * 1) Charla de Midu el 13 de octubre a las 17:00h en 42 Barcelona.
 * 2) Curso gratuito Piscine Discovery Python del 13 al 16 de octubre en 42 Barcelona.
 * Ruta estática `/42` → gana sobre el redirect dinámico de `[slug].ts`.
 */

const PYTHON_COURSE_URL =
	'https://www.eventbrite.es/e/piscine-discovery-python-42-barcelona-tickets-1997851006140?aff=oddtdtcreator';

const TALK_EVENT = {
	title: 'Charla de midudev en 42 Barcelona',
	startUTC: '2026-10-13T15:00:00Z',
	endUTC: '2026-10-13T16:30:00Z',
	location: "42 Barcelona, Parc Tecnològic de Barcelona Activa, Carrer d'Albert Einstein, 11, 08042 Barcelona",
	description: [
		'Charla presencial de Miguel Ángel Durán (@midudev) en el campus de 42 Barcelona.',
		'',
		'Cuándo: Martes 13 de octubre de 2026 a las 17:00h (hora de Barcelona).',
		"Dónde: 42 Barcelona · Parc Tecnològic de Barcelona Activa, Carrer d'Albert Einstein, 11, 08042 Barcelona.",
		'',
		'Además, del 13 al 16 de octubre se celebra el curso intensivo y gratuito Piscine Discovery Python en 42 Barcelona:',
		PYTHON_COURSE_URL,
		'',
		'Más info: https://midu.link/42',
	].join('\n'),
};

const googleCalendarUrl = (() => {
	const params = new URLSearchParams({
		action: 'TEMPLATE',
		text: TALK_EVENT.title,
		dates: '20261013T150000Z/20261013T163000Z',
		details: TALK_EVENT.description,
		location: TALK_EVENT.location,
		ctz: 'Europe/Madrid',
	});
	return `https://calendar.google.com/calendar/render?${params.toString()}`;
})();

const outlookParams = new URLSearchParams({
	path: '/calendar/action/compose',
	rru: 'addevent',
	subject: TALK_EVENT.title,
	startdt: TALK_EVENT.startUTC,
	enddt: TALK_EVENT.endUTC,
	body: TALK_EVENT.description,
	location: TALK_EVENT.location,
});
const outlookLiveUrl = `https://outlook.live.com/calendar/0/deeplink/compose?${outlookParams.toString()}`;
const outlookOfficeUrl = `https://outlook.office.com/calendar/0/deeplink/compose?${outlookParams.toString()}`;

const calendarOptions = [
	{ label: 'Google Calendar', href: googleCalendarUrl, icon: 'google' as const },
	{ label: 'Apple Calendar (.ics)', ics: true, icon: 'apple' as const },
	{ label: 'Outlook.com', href: outlookLiveUrl, icon: 'outlook' as const },
	{ label: 'Outlook 365', href: outlookOfficeUrl, icon: 'outlook' as const },
	{ label: 'Otro calendario (.ics)', ics: true, icon: 'ics' as const },
];

const pageTitle = 'midudev en 42 Barcelona · Charla (13 oct, 17h) y Curso de Python';
const pageDescription =
	'Charla de midudev el martes 13 de octubre a las 17:00h en 42 Barcelona y curso intensivo gratuito Piscine Discovery Python del 13 al 16 de octubre.';
const canonical = new URL('/42', Astro.site ?? 'https://midu.link').href;
const ogImage = new URL('/og.png', Astro.site ?? 'https://midu.link').href;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Event',
		name: TALK_EVENT.title,
		description: 'Charla presencial de Miguel Ángel Durán (@midudev) en 42 Barcelona.',
		startDate: '2026-10-13T17:00:00+02:00',
		endDate: '2026-10-13T18:30:00+02:00',
		eventStatus: 'https://schema.org/EventScheduled',
		eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
		inLanguage: 'es',
		isAccessibleForFree: true,
		url: canonical,
		image: ogImage,
		location: {
			'@type': 'Place',
			name: '42 Barcelona',
			address: {
				'@type': 'PostalAddress',
				streetAddress: "Carrer d'Albert Einstein, 11",
				postalCode: '08042',
				addressLocality: 'Barcelona',
				addressCountry: 'ES',
			},
		},
		performer: { '@type': 'Person', name: 'Miguel Ángel Durán (midudev)', url: 'https://midu.dev' },
		organizer: { '@type': 'Organization', name: '42 Barcelona · Fundación Telefónica', url: 'https://www.42barcelona.com' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'EducationEvent',
		name: 'Piscine Discovery Python · 42 Barcelona',
		description: 'Curso intensivo y gratuito de Python en 42 Barcelona del 13 al 16 de octubre.',
		startDate: '2026-10-13T09:42:00+02:00',
		endDate: '2026-10-16T15:00:00+02:00',
		eventStatus: 'https://schema.org/EventScheduled',
		eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
		inLanguage: 'es',
		isAccessibleForFree: true,
		url: PYTHON_COURSE_URL,
		location: {
			'@type': 'Place',
			name: '42 Barcelona',
			address: {
				'@type': 'PostalAddress',
				streetAddress: "Carrer d'Albert Einstein, 11",
				postalCode: '08042',
				addressLocality: 'Barcelona',
				addressCountry: 'ES',
			},
		},
		organizer: { '@type': 'Organization', name: '42 Barcelona · Fundación Telefónica', url: 'https://www.42barcelona.com' },
	},
];
