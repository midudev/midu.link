		<script define:vars={{ TALK_EVENT }}>
			const icsEscape = (s) =>
				String(s)
					.replace(/\\/g, '\\\\')
					.replace(/;/g, '\\;')
					.replace(/,/g, '\\,')
					.replace(/\r?\n/g, '\\n');

			const fold = (line) => {
				const bytes = new TextEncoder().encode(line);
				if (bytes.length <= 75) return line;
				const out = [];
				let chunk = '';
				let size = 0;
				for (const ch of line) {
					const len = new TextEncoder().encode(ch).length;
					if (size + len > (out.length ? 74 : 75)) {
						out.push(chunk);
						chunk = '';
						size = 0;
					}
					chunk += ch;
					size += len;
				}
				if (chunk) out.push(chunk);
				return out.join('\r\n ');
			};

			const toIcsDate = (iso) => iso.replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
			const uid = 'charla-midudev-42-barcelona-2026@midu.link';

			const buildIcs = () => {
				const lines = [
					'BEGIN:VCALENDAR',
					'VERSION:2.0',
					'PRODID:-//midu.link//42-barcelona//ES',
					'CALSCALE:GREGORIAN',
					'METHOD:PUBLISH',
					'BEGIN:VEVENT',
					`UID:${uid}`,
					`DTSTAMP:${toIcsDate(new Date().toISOString())}`,
					`DTSTART:${toIcsDate(TALK_EVENT.startUTC)}`,
					`DTEND:${toIcsDate(TALK_EVENT.endUTC)}`,
					`SUMMARY:${icsEscape(TALK_EVENT.title)}`,
					`DESCRIPTION:${icsEscape(TALK_EVENT.description)}`,
					`LOCATION:${icsEscape(TALK_EVENT.location)}`,
					`URL:${window.location.origin}/42`,
					'STATUS:CONFIRMED',
					'TRANSP:OPAQUE',
					'BEGIN:VALARM',
					'ACTION:DISPLAY',
					`DESCRIPTION:${icsEscape('Empieza en 30 min: ' + TALK_EVENT.title)}`,
					'TRIGGER:-PT30M',
					'END:VALARM',
					'END:VEVENT',
					'END:VCALENDAR',
				];
				return lines.map(fold).join('\r\n') + '\r\n';
			};

			const downloadIcs = () => {
				const blob = new Blob([buildIcs()], { type: 'text/calendar;charset=utf-8' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'charla-midudev-42-barcelona.ics';
				a.rel = 'noopener';
				document.body.appendChild(a);
				a.click();
				a.remove();
				setTimeout(() => URL.revokeObjectURL(url), 10_000);
			};

			const menus = Array.from(document.querySelectorAll('.js-menu'));
			const closeMenus = (except) => {
				for (const m of menus) if (m !== except) m.open = false;
			};

			for (const menu of menus) {
				menu.addEventListener('toggle', () => {
					if (menu.open) closeMenus(menu);
				});
			}

			document.addEventListener('click', (e) => {
				if (!menus.some((m) => m.contains(e.target))) closeMenus();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return;
				const open = menus.find((m) => m.open);
				if (open) {
					open.open = false;
					open.querySelector('summary')?.focus();
				}
			});

			const icsStatus = document.getElementById('ics-status');
			for (const btn of document.querySelectorAll('.js-download-ics')) {
				btn.addEventListener('click', () => {
					const menu = btn.closest('.js-menu');
					downloadIcs();
					closeMenus();
					menu?.querySelector('summary')?.focus();
					if (icsStatus) {
						icsStatus.textContent = '';
						icsStatus.textContent = 'Archivo de calendario descargado.';
					}
				});
			}

			// Registrar visita en las analíticas de midu.link
			try {
				const payload = JSON.stringify({ slug: '42' });
				if (navigator.sendBeacon) {
					navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
				} else {
					fetch('/api/track', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: payload,
						keepalive: true,
					}).catch(() => {});
				}
			} catch {}
		</script>
	</body>
</html>

